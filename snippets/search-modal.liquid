{% comment %}
  Shugroves Emporium - Fullscreen Search Overlay Snippet
{% endcomment %}

<div class="search-overlay-backdrop" id="searchOverlayBackdrop"></div>

<div class="search-overlay-container" id="searchOverlayContainer">
  <div class="search-overlay-header">
    <span class="search-overlay-brand">{{ settings.brand_name | default: shop.name }}</span>
    <button type="button" class="search-overlay-close" id="searchOverlayClose" aria-label="Close search">
      {% render 'icon-close' %}
    </button>
  </div>

  <div class="search-overlay-body">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay-form" id="searchOverlayForm">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      
      <div class="search-input-wrap">
        {% render 'icon-search' %}
        <input 
          type="search" 
          name="q" 
          id="searchOverlayInput" 
          class="search-input-field" 
          placeholder="Search pieces, silhouettes, or fabrics..." 
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="reset" class="search-clear-btn" id="searchClearBtn" aria-label="Clear search query" style="display:none;">&times;</button>
      </div>
    </form>

    <!-- Quick Search Suggestions -->
    <div class="search-suggestions-row" id="searchSuggestionsRow">
      <span class="suggestions-label">Popular Inquiries:</span>
      <div class="suggestions-tags">
        <a href="{{ routes.search_url }}?q=linen&type=product" class="suggestion-tag">Belgian Linen</a>
        <a href="{{ routes.search_url }}?q=knit&type=product" class="suggestion-tag">Artisanal Knits</a>
        <a href="{{ routes.search_url }}?q=coat&type=product" class="suggestion-tag">Outerwear</a>
        <a href="{{ routes.search_url }}?q=silk&type=product" class="suggestion-tag">Organic Silk</a>
        <a href="{{ routes.search_url }}?q=bag&type=product" class="suggestion-tag">Suede Bags</a>
      </div>
    </div>

    <!-- Live Predictive Search Results Container -->
    <div class="search-results-wrapper" id="searchResultsWrapper">
      <div class="search-results-grid product-grid product-grid-4" id="searchResultsGrid"></div>
      <div class="search-no-results" id="searchNoResults" style="display:none;">
        <p>No creations matched your search inquiry.</p>
      </div>
    </div>
  </div>
</div>
