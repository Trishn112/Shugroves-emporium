# ==============================================================================
# SHUGROVES EMPORIUM - SHOPIFY STOREFRONT API CONFIGURATION
# ==============================================================================
# Instructions:
# 1. In your Shopify Admin, go to: Settings > Apps and sales channels > Develop apps
# 2. Create an app (e.g. "Shugroves Headless Storefront")
# 3. Under "Configuration", enable "Storefront API integration" with permissions:
#    - Read products, variants, and collections
#    - Read and write customer carts and checkouts
# 4. Under "API credentials", copy the "Storefront API access token"
# 5. Fill in the credentials below:

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token
SHOPIFY_API_VERSION=2024-07
