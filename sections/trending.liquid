{% comment %}
  Shugroves Emporium - Trending Now Curated Products Section
{% endcomment %}

<div class="section-container" id="trendingSection">
  <!-- Section Editorial Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Curated Pieces" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "Trending Now" }}</h2>
    </div>
    <div class="section-header-right">
      {%- assign col_link = section.settings.collection.url | default: routes.all_products_collection_url -%}
      <a href="{{ col_link }}" class="btn-text-link">
        {{ section.settings.view_all_text | default: "View All Creations &rarr;" }}
      </a>
    </div>
  </div>

  <!-- Product Cards Grid -->
  {%- assign collection = section.settings.collection -%}
  {%- assign products_to_display = collection.products | default: collections.all.products -%}
  
  <div class="product-grid product-grid-4">
    {%- if products_to_display != blank and products_to_display.size > 0 -%}
      {%- for product in products_to_display limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      <div class="empty-state-card" style="grid-column: 1 / -1; text-align: center; padding: 4rem 2rem; background: var(--bg-cream-tint); border: 1px solid var(--border-subtle); border-radius: 16px;">
        <h3 class="empty-state-title" style="font-family: var(--font-serif); font-size: 1.6rem; color: var(--text-charcoal); margin-bottom: 0.5rem;">No trending creations available</h3>
        <p class="empty-state-desc" style="color: var(--text-charcoal-muted); max-width: 480px; margin: 0 auto 1.5rem; font-size: 0.9rem;">Products added to your store will automatically appear here.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-primary" style="display: inline-block; padding: 0.8rem 1.8rem; border-radius: 24px;">Explore Core Archive</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Trending Now",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Pieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View All Creations →"
    }
  ],
  "presets": [
    {
      "name": "Trending Now"
    }
  ]
}
{% endschema %}
