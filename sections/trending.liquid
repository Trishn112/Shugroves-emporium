{% comment %}
  Shugroves Emporium - Trending Now Curated Products Section
{% endcomment %}

<div class="section-container" id="trendingSection">
  <!-- Section Editorial Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Curated Pieces" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "Trending Now" }}</h2>
    </div>
    <div class="section-header-right">
      {%- assign col_link = section.settings.collection.url | default: routes.all_products_collection_url -%}
      <a href="{{ col_link }}" class="btn-text-link">
        {{ section.settings.view_all_text | default: "View All Creations &rarr;" }}
      </a>
    </div>
  </div>

  <!-- Product Cards Grid -->
  {%- assign collection = section.settings.collection -%}
  {%- assign products_to_display = collection.products | default: collections.all.products -%}
  
  <div class="product-grid product-grid-4">
    {%- if products_to_display != blank and products_to_display.size > 0 -%}
      {%- for product in products_to_display limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      <!-- Default Trending Preview Pieces Matching Original Design -->
      <div class="product-card">
        <div class="product-card-media">
          <img src="https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=800&q=85" alt="Sienna Raw Linen Wrap Dress" class="product-img product-img-primary" loading="lazy" width="400" height="533">
          <button type="button" class="product-wishlist-btn" aria-label="Add to Wishlist">
            {% render 'icon-wishlist' %}
          </button>
        </div>
        <div class="product-card-body">
          <span class="product-card-material">Belgian Raw Linen</span>
          <h3 class="product-card-title"><a href="{{ routes.all_products_collection_url }}">Sienna Raw Linen Wrap Dress</a></h3>
          <div class="product-card-price-row">
            <span class="product-price-current">Rs. 5,400</span>
          </div>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=85" alt="Sage Meadow Oversized Knit" class="product-img product-img-primary" loading="lazy" width="400" height="533">
          <div class="product-badges">
            <span class="badge-tag badge-new">New Arrival</span>
            <span class="badge-tag badge-sale">Special Price</span>
          </div>
          <button type="button" class="product-wishlist-btn" aria-label="Add to Wishlist">
            {% render 'icon-wishlist' %}
          </button>
        </div>
        <div class="product-card-body">
          <span class="product-card-material">Merino Wool & Silk</span>
          <h3 class="product-card-title"><a href="{{ routes.all_products_collection_url }}">Sage Meadow Oversized Knit</a></h3>
          <div class="product-card-price-row">
            <span class="product-price-current">Rs. 4,800</span>
            <span class="product-price-original">Rs. 5,600</span>
          </div>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=800&q=85" alt="Ochre Sculpted Suede Saddle Bag" class="product-img product-img-primary" loading="lazy" width="400" height="533">
          <div class="product-badges">
            <span class="badge-tag badge-new">New Arrival</span>
            <span class="badge-tag badge-low">Low Stock</span>
          </div>
          <button type="button" class="product-wishlist-btn" aria-label="Add to Wishlist">
            {% render 'icon-wishlist' %}
          </button>
        </div>
        <div class="product-card-body">
          <span class="product-card-material">Vegetal Tanned Leather</span>
          <h3 class="product-card-title"><a href="{{ routes.all_products_collection_url }}">Ochre Sculpted Suede Saddle Bag</a></h3>
          <div class="product-card-price-row">
            <span class="product-price-current">Rs. 8,200</span>
          </div>
        </div>
      </div>

      <div class="product-card">
        <div class="product-card-media">
          <img src="https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=800&q=85" alt="Botanical Olive Oversized Cardigan" class="product-img product-img-primary" loading="lazy" width="400" height="533">
          <div class="product-badges">
            <span class="badge-tag badge-sale">Special Price</span>
          </div>
          <button type="button" class="product-wishlist-btn" aria-label="Add to Wishlist">
            {% render 'icon-wishlist' %}
          </button>
        </div>
        <div class="product-card-body">
          <span class="product-card-material">Organic Belgian Linen</span>
          <h3 class="product-card-title"><a href="{{ routes.all_products_collection_url }}">Botanical Olive Oversized Cardigan</a></h3>
          <div class="product-card-price-row">
            <span class="product-price-current">Rs. 6,100</span>
            <span class="product-price-original">Rs. 7,200</span>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Trending Now",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Pieces"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "View All Creations →"
    }
  ],
  "presets": [
    {
      "name": "Trending Now"
    }
  ]
}
{% endschema %}
