{% comment %}
  Shugroves Emporium - Help & Customer Support Section with Real Shopify Contact Form
{% endcomment %}

<div class="help-page-wrapper">
  <!-- Header -->
  <header class="help-header">
    <div class="section-container help-header-inner">
      <span class="help-eyebrow">{{ section.settings.eyebrow | default: "Client Care & Inquiries" }}</span>
      <h1 class="help-title">{{ section.settings.heading | default: "How May We Assist You?" }}</h1>
      <p class="help-subtitle">
        {{ section.settings.subtitle | default: "Our dedicated concierge team is available to assist with bespoke sizing, styling advice, orders, and delivery logistics." }}
      </p>
    </div>
  </header>

  <div class="section-container help-main-layout">
    <!-- Contact Concierge Cards Row -->
    {%- assign support_email = settings.contact_email | default: shop.email -%}
    <div class="concierge-cards-grid">
      <!-- 1. Telephone -->
      {%- if settings.contact_phone != blank -%}
        <a href="tel:{{ settings.contact_phone_tel | default: settings.contact_phone }}" class="concierge-card" title="Call Concierge">
          <div class="concierge-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <h3 class="concierge-card-title">Telephone Inquiries</h3>
          <p class="concierge-card-val">{{ settings.contact_phone }}</p>
          <span class="concierge-card-sub">{{ settings.business_hours | default: "Mon – Sat: 10am – 7pm IST" }}</span>
        </a>
      {%- else -%}
        <a href="#ContactForm" class="concierge-card" title="Send Client Note">
          <div class="concierge-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <h3 class="concierge-card-title">Client Advisory Desk</h3>
          <p class="concierge-card-val">Send an Inquiry</p>
          <span class="concierge-card-sub">Online advisory & garment assistance</span>
        </a>
      {%- endif -%}

      <!-- 2. WhatsApp or Bespoke Alterations -->
      {%- if settings.contact_whatsapp != blank -%}
        <a href="{{ settings.contact_whatsapp_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="concierge-card" title="Chat on WhatsApp">
          <div class="concierge-card-icon contact-icon-whatsapp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </div>
          <h3 class="concierge-card-title">WhatsApp Concierge</h3>
          <p class="concierge-card-val">{{ settings.contact_whatsapp }}</p>
          <span class="concierge-card-sub">Instant styling & sizing support</span>
        </a>
      {%- else -%}
        <a href="#faqAccordion" class="concierge-card" title="Frequently Asked Questions">
          <div class="concierge-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <h3 class="concierge-card-title">Client Knowledge Base</h3>
          <p class="concierge-card-val">FAQs & Care Guide</p>
          <span class="concierge-card-sub">Shipping, returns & natural fiber care</span>
        </a>
      {%- endif -%}

      <!-- 3. Email -->
      {%- if support_email != blank -%}
        <a href="mailto:{{ support_email }}" class="concierge-card" title="Email Concierge">
          <div class="concierge-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <h3 class="concierge-card-title">Email Correspondence</h3>
          <p class="concierge-card-val">{{ support_email }}</p>
          <span class="concierge-card-sub">Response within 24 business hours</span>
        </a>
      {%- endif -%}
    </div>

    <!-- Split Grid: Real Shopify Contact Form & FAQ Accordion -->
    <div class="help-split-grid">
      
      <!-- Left: Real Shopify Contact Form -->
      <div class="help-form-container">
        <h2 class="help-section-heading">Send a Message to the Atelier</h2>
        <p class="help-section-desc">Leave your note below and our client advisory team will respond promptly.</p>

        {%- if page.content != blank -%}
          <div class="help-page-custom-content rte" style="margin-bottom: 1.5rem; line-height: 1.7; color: var(--text-charcoal-muted);">
            {{ page.content }}
          </div>
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm', class: 'shopify-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-success" style="background:#EBF3E8; color:#3F5A36; padding:1.2rem; border-radius:10px; margin-bottom:1.5rem;">
              <strong>Thank you for contacting Shugroves Atelier.</strong>
              <p style="margin-top:0.4rem; font-size:0.9rem;">Your inquiry has been received. Our concierge team will reach out to you shortly.</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form-status form-status-error" style="background:#FDE8E8; color:#9B1C1C; padding:1.2rem; border-radius:10px; margin-bottom:1.5rem;">
              <strong>Please check the following errors:</strong>
              <p style="margin-top:0.4rem; font-size:0.9rem;">{{ form.errors | default_errors }}</p>
            </div>
          {%- endif -%}

          <div class="form-group">
            <label for="ContactFormName" class="form-label">Full Name</label>
            <input type="text" name="contact[name]" id="ContactFormName" class="form-input" placeholder="Your full name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
          </div>

          <div class="form-row form-row-2">
            <div class="form-group">
              <label for="ContactFormEmail" class="form-label">Email Address</label>
              <input type="email" name="contact[email]" id="ContactFormEmail" class="form-input" placeholder="your.email@example.com" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
            </div>
            <div class="form-group">
              <label for="ContactFormPhone" class="form-label">Phone Number (Optional)</label>
              <input type="tel" name="contact[phone]" id="ContactFormPhone" class="form-input" placeholder="Your phone number" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            </div>
          </div>

          <div class="form-group">
            <label for="ContactFormBody" class="form-label">Message / Inquiry Details</label>
            <textarea rows="5" name="contact[body]" id="ContactFormBody" class="form-textarea" placeholder="How may we assist you with our garments, sizing, or orders?" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn-primary" style="width:100%; justify-content:center; padding:1rem;">
            <span>Submit Message &rarr;</span>
          </button>
        {%- endform -%}
      </div>

      <!-- Right: Frequently Asked Questions Accordion -->
      <div class="help-faq-container">
        <h2 class="help-section-heading">Frequently Asked Questions</h2>
        
        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">What is your shipping timeline and policy?</summary>
            <div class="faq-answer">
              <p>We provide complimentary express courier shipping across India on orders over {{ settings.free_shipping_threshold | default: 5000 | money }}. Orders are hand-packed at our Mumbai atelier and dispatched within 24–48 hours, arriving within 3–5 business days.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">How do I care for pure Belgian linen and organic silks?</summary>
            <div class="faq-answer">
              <p>We recommend gentle hand washing in cool water with pH-neutral organic detergent, or eco-dry cleaning. Always dry in the shade to preserve living botanical dye hues. Iron damp on medium heat or embrace linen's natural textured wrinkles.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">What is your return and exchange policy?</summary>
            <div class="faq-answer">
              <p>We offer complimentary 30-day returns and exchanges for all unworn pieces in their original packaging with atelier hangtags intact. Simply reach out to our concierge or initiate through your account ledger.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Do you offer custom tailoring and bespoke alterations?</summary>
            <div class="faq-answer">
              <p>Yes. For select outerwear and linen trousers, our master tailors can adjust hem lengths and sleeves upon request prior to dispatch. Contact concierge with your measurements after placing your order.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Help & Contact Us",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Client Care & Inquiries"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How May We Assist You?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our dedicated concierge team is available to assist with bespoke sizing, styling advice, orders, and delivery logistics."
    }
  ],
  "presets": [
    {
      "name": "Help & Contact Us"
    }
  ]
}
{% endschema %}
