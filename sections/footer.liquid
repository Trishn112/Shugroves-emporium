{% comment %}
  Shugroves Emporium - Conscious Philosophy Banner & Master Footer Section
{% endcomment %}

<!-- Editorial Quote Banner Section -->
<section class="quote-banner-section" aria-label="Conscious Philosophy">
  <div class="quote-banner-inner">
    <span class="quote-eyebrow">{{ section.settings.quote_eyebrow | default: "Conscious Philosophy" }}</span>
    <blockquote class="editorial-banner-quote">
      &ldquo;{{ section.settings.quote_text | default: "Formed by natural flax, tempered by slow vegetal dyes, tailored for perpetual ease." }}&rdquo;
    </blockquote>
    <span class="quote-author">{{ section.settings.quote_author | default: "Shugroves Atelier • Est. 2026" }}</span>
  </div>
</section>

<!-- Master Footer Section -->
<footer class="site-footer" id="siteFooter">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand & Mission Column -->
      <div class="footer-brand-col">
        <span class="footer-brand-title">Shugroves Emporium</span>
        <p class="footer-brand-bio">
          {{ section.settings.brand_bio | default: "An artisanal clothing and objects atelier dedicated to unbleached Belgian linen, vegetal extraction dyeing, and timeless everyday ease." }}
        </p>
        <div class="footer-eco-badge">
          <span>Slow Crafted • Zero Synthetic Blends</span>
        </div>
      </div>

      <!-- Navigation Col 1: Collections -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Collections</h4>
        <ul class="footer-links">
          <li><a href="{{ routes.collections_url }}">Clothing & Outerwear</a></li>
          <li><a href="{{ routes.collections_url }}">Artisanal Knitwear</a></li>
          <li><a href="{{ routes.collections_url }}">Leather & Objects</a></li>
          <li><a href="{{ routes.collections_url }}">Sculptural Jewellery</a></li>
          <li><a href="/pages/offers">Seasonal Offers</a></li>
        </ul>
      </div>

      <!-- Navigation Col 2: Atelier & Care -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Atelier & Care</h4>
        <ul class="footer-links">
          <li><a href="/pages/about-us">About Our Atelier</a></li>
          <li><a href="/pages/lookbook">Seasonal Lookbook</a></li>
          <li><a href="/blogs/journal">Editorial Journal</a></li>
          <li><a href="/pages/help">Help & Contact</a></li>
        </ul>
      </div>

      <!-- Column 4: Private Ledger / Newsletter -->
      <div class="footer-newsletter-col">
        <h4 class="footer-heading">Private Ledger</h4>
        <p class="footer-news-text">Receive private seasonal release previews and invitations to limited numbered dye drops.</p>
        
        {%- form 'customer', class: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input 
            type="email" 
            name="contact[email]" 
            class="footer-input" 
            placeholder="Your email address" 
            required
            autocomplete="email"
          >
          <button type="submit" class="footer-submit-btn" aria-label="Join Private Ledger">
            &rarr;
          </button>
        {%- endform -%}
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom-row">
      <span class="footer-copy">&copy; {{ 'now' | date: "%Y" }} Shugroves Emporium. All rights reserved. Handcrafted slow fashion.</span>
      <div class="footer-legal-links">
        <a href="/pages/help">Privacy Policy</a>
        <span>•</span>
        <a href="/pages/help">Terms of Atelier</a>
        <span>•</span>
        <a href="/pages/help">Carbon Neutral Dispatches</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer & Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "quote_eyebrow",
      "label": "Quote Eyebrow",
      "default": "Conscious Philosophy"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Philosophy Quote",
      "default": "Formed by natural flax, tempered by slow vegetal dyes, tailored for perpetual ease."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Attribution",
      "default": "Shugroves Atelier • Est. 2026"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Atelier Bio",
      "default": "An artisanal clothing and objects atelier dedicated to unbleached Belgian linen, vegetal extraction dyeing, and timeless everyday ease."
    }
  ]
}
{% endschema %}
