{% comment %}
  Shugroves Emporium - Default Page Section
{% endcomment %}

<div class="page-standard-wrapper" style="padding-top: 8.5rem; min-height: 70vh;">
  <div class="section-container" style="max-width: 860px; margin: 0 auto; padding: 2rem 2rem 6rem;">
    <header style="text-align:center; margin-bottom: 2.5rem;">
      <h1 class="collections-title">{{ page.title }}</h1>
    </header>

    <div class="page-content-body rte" style="line-height: 1.8; color: var(--text-charcoal-muted); font-size: 1rem;">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
