{% comment %}
  Shugroves Emporium - The Edit: Visual Discovery & Shop The Look Masonry
{% endcomment %}

<div class="section-container" id="theEditSection">
  <!-- Editorial Section Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Visual Discovery" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "The Edit" }}</h2>
    </div>
    <div class="section-header-right">
      <p class="section-subtitle">{{ section.settings.subtitle | default: "Visual outfit studies, tonal harmonies & curated seasonal styling." }}</p>
    </div>
  </div>

  <!-- Masonry Editorial Grid -->
  <div class="edit-masonry-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign p1 = block.settings.product_1 -%}
        {%- assign p2 = block.settings.product_2 -%}
        <div class="edit-card edit-card-{{ block.settings.aspect_ratio | default: 'tall' }}" {{ block.shopify_attributes }}>
          <div class="edit-card-inner">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" class="edit-card-img" loading="lazy" width="450" height="600">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=85" alt="Editorial look" class="edit-card-img" loading="lazy" width="450" height="600">
            {%- endif -%}

            <div class="edit-card-overlay">
              <span class="edit-card-category">{{ block.settings.category | default: "Styling Inspiration" }}</span>
              <h3 class="edit-card-title">{{ block.settings.title }}</h3>
              <p class="edit-card-desc">{{ block.settings.description }}</p>

              {%- if p1 != blank or p2 != blank -%}
                <div class="edit-card-products-preview">
                  {%- if p1 != blank -%}
                    <a href="{{ p1.url }}" class="btn-shop-look-item">
                      <span>{{ p1.title | truncate: 24 }} &bull; {{ p1.price | money }}</span>
                    </a>
                  {%- endif -%}
                  {%- if p2 != blank -%}
                    <a href="{{ p2.url }}" class="btn-shop-look-item">
                      <span>{{ p2.title | truncate: 24 }} &bull; {{ p2.price | money }}</span>
                    </a>
                  {%- endif -%}
                </div>
              {%- else -%}
                <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
                  <span>Explore Atelier Pieces &rarr;</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Default Built-in Editorial Blocks -->
      <div class="edit-card edit-card-tall">
        <div class="edit-card-inner">
          <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=85" alt="The Autumn Layering Formula" class="edit-card-img" loading="lazy" width="450" height="600">
          <div class="edit-card-overlay">
            <span class="edit-card-category">Styling Inspiration</span>
            <h3 class="edit-card-title">The Autumn Layering Formula</h3>
            <p class="edit-card-desc">Pairing fluid Belgian linen outerwear with structural leather accessories in tonal earthy hues.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look"><span>Explore Silhouette &rarr;</span></a>
          </div>
        </div>
      </div>
      <div class="edit-card edit-card-wide">
        <div class="edit-card-inner">
          <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=85" alt="Tactile Sage & Raw Flax" class="edit-card-img" loading="lazy" width="450" height="300">
          <div class="edit-card-overlay">
            <span class="edit-card-category">Material Focus</span>
            <h3 class="edit-card-title">Tactile Sage & Raw Flax</h3>
            <p class="edit-card-desc">The interplay of open-knit merino wool against double-pleated Belgian linen trousers.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look"><span>Explore Silhouette &rarr;</span></a>
          </div>
        </div>
      </div>
      <div class="edit-card edit-card-tall">
        <div class="edit-card-inner">
          <img src="https://images.unsplash.com/photo-1509967419530-da38b4704bc6?auto=format&fit=crop&w=900&q=85" alt="Vegetal Silk in Afternoon Sun" class="edit-card-img" loading="lazy" width="450" height="600">
          <div class="edit-card-overlay">
            <span class="edit-card-category">Color Study</span>
            <h3 class="edit-card-title">Vegetal Silk in Afternoon Sun</h3>
            <p class="edit-card-desc">Marigold-dyed Ahimsa peace silk reflecting warm amber light.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look"><span>Explore Silhouette &rarr;</span></a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "The Edit (Masonry)",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Visual Discovery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Edit"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Visual outfit studies, tonal harmonies & curated seasonal styling."
    }
  ],
  "blocks": [
    {
      "type": "curation",
      "name": "Editorial Curation",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Editorial Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Tag",
          "default": "Styling Inspiration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Autumn Layering Formula"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Pairing fluid Belgian linen outerwear with structural leather accessories in tonal earthy hues."
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect Ratio",
          "options": [
            { "value": "tall", "label": "Tall (Vertical)" },
            { "value": "wide", "label": "Wide (Horizontal)" },
            { "value": "square", "label": "Square" }
          ],
          "default": "tall"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Linked Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Linked Product 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Edit (Masonry)"
    }
  ]
}
{% endschema %}
