{% comment %}
  Shugroves Emporium - The Edit: Visual Discovery & Shop The Look Masonry
{% endcomment %}

<div class="section-container" id="theEditSection">
  <!-- Editorial Section Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Visual Discovery" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "The Edit" }}</h2>
    </div>
    <div class="section-header-right">
      <p class="section-subtitle">{{ section.settings.subtitle | default: "Visual outfit studies, tonal harmonies & curated seasonal styling." }}</p>
    </div>
  </div>

  <!-- Masonry Editorial Grid -->
  <div class="edit-masonry-grid">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign card_size_class = block.settings.card_size | default: 'tall' -%}
        <div class="edit-card edit-card-{{ card_size_class }}" {{ block.shopify_attributes }}>
          <div class="edit-card-inner">
            {%- if block.settings.image != blank -%}
              <img 
                src="{{ block.settings.image | image_url: width: 900 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="edit-card-img" 
                loading="lazy" 
                width="450" 
                height="600"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'edit-card-img placeholder-svg' }}
            {%- endif -%}

            <div class="edit-card-overlay">
              {%- if block.settings.category != blank -%}
                <span class="edit-card-category">{{ block.settings.category }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="edit-card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="edit-card-desc">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.link_url != blank or block.settings.link_text != blank -%}
                <a href="{{ block.settings.link_url | default: routes.all_products_collection_url }}" class="btn-shop-look">
                  <span>{{ block.settings.link_text | default: "Explore Curation" }}</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Default Masonry Structure using Store Collections & Theme Palette -->
      {%- for col in collections limit: 5 -%}
        {%- assign idx = forloop.index -%}
        {%- case idx -%}
          {%- when 1 -%}{%- assign size = 'tall' -%}
          {%- when 2 -%}{%- assign size = 'wide' -%}
          {%- when 3 -%}{%- assign size = 'tall' -%}
          {%- when 4 -%}{%- assign size = 'square' -%}
          {%- when 5 -%}{%- assign size = 'wide' -%}
        {%- endcase -%}
        <div class="edit-card edit-card-{{ size }}">
          <div class="edit-card-inner">
            {%- if col.image != blank -%}
              <img src="{{ col.image | image_url: width: 900 }}" alt="{{ col.title | escape }}" class="edit-card-img" loading="lazy" width="450" height="600">
            {%- elsif col.products.first.featured_image != blank -%}
              <img src="{{ col.products.first.featured_image | image_url: width: 900 }}" alt="{{ col.title | escape }}" class="edit-card-img" loading="lazy" width="450" height="600">
            {%- else -%}
              {{ 'collection-' | append: idx | placeholder_svg_tag: 'edit-card-img placeholder-svg' }}
            {%- endif -%}
            <div class="edit-card-overlay">
              <span class="edit-card-category">Collection Curation</span>
              <h3 class="edit-card-title">{{ col.title }}</h3>
              <p class="edit-card-desc">{{ col.description | default: "Explore conscious silhouettes and everyday luxury in this curation." }}</p>
              <a href="{{ col.url }}" class="btn-shop-look">
                <span>Shop Collection ({{ col.products_count }} {{ col.products_count | pluralize: 'Piece', 'Pieces' }})</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "The Edit",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Visual Discovery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Edit"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Visual outfit studies, tonal harmonies & curated seasonal styling."
    }
  ],
  "blocks": [
    {
      "type": "editorial_look",
      "name": "Editorial Card",
      "settings": [
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Proportions",
          "options": [
            { "value": "tall", "label": "Tall (2x Height)" },
            { "value": "wide", "label": "Wide (2x Width)" },
            { "value": "square", "label": "Square (1x1)" }
          ],
          "default": "tall"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category / Tag",
          "default": "Styling Inspiration"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Look Title",
          "default": "Seasonal Styling Study"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Look Description",
          "default": "Curated tonal harmonies and natural fiber pairings."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button Link Text",
          "default": "Shop The Look"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Edit"
    }
  ]
}
{% endschema %}
