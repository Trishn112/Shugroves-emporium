{% comment %}
  Shugroves Emporium - The Edit: Visual Discovery & Shop The Look Masonry
{% endcomment %}

<div class="section-container" id="theEditSection">
  <!-- Editorial Section Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Visual Discovery" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "The Edit" }}</h2>
    </div>
    <div class="section-header-right">
      <p class="section-subtitle">{{ section.settings.subtitle | default: "Visual outfit studies, tonal harmonies & curated seasonal styling." }}</p>
    </div>
  </div>

  <!-- Masonry Editorial Grid -->
  <div class="edit-masonry-grid">
    <!-- Card 1: Tall -->
    <div class="edit-card edit-card-tall">
      <div class="edit-card-inner">
        <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=900&q=85" alt="The Autumn Layering Formula" class="edit-card-img" loading="lazy" width="450" height="600">
        <div class="edit-card-overlay">
          <span class="edit-card-category">Styling Inspiration</span>
          <h3 class="edit-card-title">The Autumn Layering Formula</h3>
          <p class="edit-card-desc">Pairing fluid Belgian linen outerwear with structural leather accessories in tonal earthy hues.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
            <span>Shop The Look (2 Pieces)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 2: Wide -->
    <div class="edit-card edit-card-wide">
      <div class="edit-card-inner">
        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=900&q=85" alt="Tactile Sage & Raw Flax" class="edit-card-img" loading="lazy" width="450" height="300">
        <div class="edit-card-overlay">
          <span class="edit-card-category">Material Focus</span>
          <h3 class="edit-card-title">Tactile Sage & Raw Flax</h3>
          <p class="edit-card-desc">The interplay of open-knit merino wool against double-pleated Belgian linen trousers.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
            <span>Shop The Look (2 Pieces)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 3: Tall -->
    <div class="edit-card edit-card-tall">
      <div class="edit-card-inner">
        <img src="https://images.unsplash.com/photo-1509967419530-da38b4704bc6?auto=format&fit=crop&w=900&q=85" alt="Vegetal Silk in Afternoon Sun" class="edit-card-img" loading="lazy" width="450" height="600">
        <div class="edit-card-overlay">
          <span class="edit-card-category">Color Study</span>
          <h3 class="edit-card-title">Vegetal Silk in Afternoon Sun</h3>
          <p class="edit-card-desc">Marigold-dyed Ahimsa peace silk reflecting warm amber light.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
            <span>Shop The Look (2 Pieces)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 4: Square -->
    <div class="edit-card edit-card-square">
      <div class="edit-card-inner">
        <img src="https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=900&q=85" alt="Unstructured Everyday Carry" class="edit-card-img" loading="lazy" width="450" height="450">
        <div class="edit-card-overlay">
          <span class="edit-card-category">Object Curation</span>
          <h3 class="edit-card-title">Unstructured Everyday Carry</h3>
          <p class="edit-card-desc">Velvety olive-sage suede tote with artisan hand-finished details.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
            <span>Shop The Look (2 Pieces)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 5: Wide -->
    <div class="edit-card edit-card-wide">
      <div class="edit-card-inner">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=900&q=85" alt="Sculptural Brass & Warm Skin" class="edit-card-img" loading="lazy" width="450" height="300">
        <div class="edit-card-overlay">
          <span class="edit-card-category">Jewellery Study</span>
          <h3 class="edit-card-title">Sculptural Brass & Warm Skin</h3>
          <p class="edit-card-desc">Hand-hammered gold vermeil jewelry catching soft ambient shadows.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn-shop-look">
            <span>Shop The Look (1 Piece)</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "The Edit",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Visual Discovery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Edit"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Visual outfit studies, tonal harmonies & curated seasonal styling."
    }
  ]
}
{% endschema %}
