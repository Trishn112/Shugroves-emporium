{% comment %}
  Shugroves Emporium - Popular & Bestselling Products Section
{% endcomment %}

<div class="section-container" id="popularSection">
  <!-- Section Editorial Header -->
  <div class="section-header">
    <div class="section-header-left">
      <span class="section-eyebrow">{{ section.settings.eyebrow | default: "Atelier Favorites" }}</span>
      <h2 class="section-heading">{{ section.settings.heading | default: "Popular Pieces" }}</h2>
    </div>
    <div class="section-header-right">
      {%- assign col_link = section.settings.collection.url | default: routes.all_products_collection_url -%}
      <a href="{{ col_link }}?sort_by=best-selling" class="btn-text-link">
        {{ section.settings.view_all_text | default: "Explore All Bestsellers &rarr;" }}
      </a>
    </div>
  </div>

  <!-- Product Cards Grid -->
  {%- assign collection = section.settings.collection -%}
  {%- assign products_to_display = collection.products | default: collections.all.products -%}
  
  <div class="product-grid product-grid-4">
    {%- if products_to_display != blank and products_to_display.size > 0 -%}
      {%- for product in products_to_display limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="product-card">
          <div class="product-card-media">
            {{ 'product-' | append: i | placeholder_svg_tag: 'product-img product-img-primary' }}
          </div>
          <div class="product-card-body">
            <span class="product-card-material">Vegetal Dyed Silk</span>
            <h3 class="product-card-title">Popular Atelier Creation {{ i }}</h3>
            <div class="product-card-price-row">
              <span class="product-price-current">{{ 6400 | money }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Popular Pieces",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Atelier Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Popular Collection (or leave blank for all products)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "Explore All Bestsellers →"
    }
  ],
  "presets": [
    {
      "name": "Popular Pieces"
    }
  ]
}
{% endschema %}
