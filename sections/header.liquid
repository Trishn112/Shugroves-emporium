{% comment %}
  Shugroves Emporium - Master Header Section
{% endcomment %}

<header class="site-header" id="siteHeader">
  <!-- 1. Left: Brand Logotype with Swash -->
  <a href="{{ routes.root_url }}" class="brand-container" id="brandElement" title="{{ shop.name }} Home">
    <span class="brand-title">{{ section.settings.brand_text | default: settings.brand_name | default: 'Shugroves Emporium' }}</span>
    <div class="brand-swash-box" aria-hidden="true">
      <svg viewBox="0 0 300 12" preserveAspectRatio="none">
        <path d="M 4,6 Q 150,-2 296,6" />
      </svg>
    </div>
  </a>

  <!-- 2. Center: Desktop Editorial Navigation Links -->
  <nav class="main-nav" aria-label="Main Navigation">
    <ul class="nav-links">
      <!-- 1. COLLECTIONS Dropdown -->
      <li class="nav-dropdown-parent">
        <a href="{{ routes.collections_url }}" class="nav-item-link">Collections</a>
        <div class="nav-megamenu" id="collectionsMegamenu">
          <div class="megamenu-search-wrap">
            {% render 'icon-search' %}
            <input 
              type="text" 
              class="megamenu-search-input" 
              id="collectionsSearchInput" 
              placeholder="Search Collections..." 
              autocomplete="off"
            >
          </div>

          <div class="megamenu-grid">
            <!-- Column 1: Categories List -->
            <div class="megamenu-col" id="colListCol1">
              <span class="megamenu-heading">Apparel & Tailoring</span>
              <div class="megamenu-links-dynamic" id="dynColList1">
                {%- if collections.size > 0 -%}
                  {%- for col in collections limit: 6 -%}
                    <a href="{{ col.url }}" class="megamenu-link-item">
                      <span>{{ col.title }}</span>
                      <span class="megamenu-link-arrow">&rarr;</span>
                    </a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ routes.collections_url }}" class="megamenu-link-item">
                    <span>All Collections</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>

            <!-- Column 2: Objects & Archive -->
            <div class="megamenu-col" id="colListCol2">
              <span class="megamenu-heading">Objects & Archive</span>
              <div class="megamenu-links-dynamic" id="dynColList2">
                {%- if collections.size > 6 -%}
                  {%- for col in collections offset: 6 limit: 6 -%}
                    <a href="{{ col.url }}" class="megamenu-link-item">
                      <span>{{ col.title }}</span>
                      <span class="megamenu-link-arrow">&rarr;</span>
                    </a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="megamenu-link-item">
                    <span>New Arrivals</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                  <a href="/pages/offers" class="megamenu-link-item">
                    <span>Seasonal Offers</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
              <a href="{{ routes.collections_url }}" class="megamenu-view-all">View All Collections &rarr;</a>
            </div>

            <!-- Column 3: Featured Editorial Card -->
            <div class="megamenu-col megamenu-featured-card-col">
              {%- assign featured_col = collections[section.settings.featured_collection] | default: collections.first -%}
              {%- if featured_col != blank -%}
                <a href="{{ featured_col.url }}" class="megamenu-card-preview">
                  <div class="megamenu-card-img-wrap">
                    {%- if featured_col.image != blank -%}
                      <img src="{{ featured_col.image | image_url: width: 600 }}" alt="{{ featured_col.title | escape }}">
                    {%- elsif featured_col.products.first.featured_image != blank -%}
                      <img src="{{ featured_col.products.first.featured_image | image_url: width: 600 }}" alt="{{ featured_col.title | escape }}">
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <div class="megamenu-card-overlay">
                      <span class="megamenu-card-badge">Featured Curation</span>
                      <h4 class="megamenu-card-title">{{ featured_col.title }}</h4>
                      <span class="megamenu-card-link">Explore Collection &rarr;</span>
                    </div>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </li>

      <!-- 2. POPULAR -->
      <li>
        <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="nav-item-link">Popular</a>
      </li>

      <!-- 3. LOOKBOOK -->
      <li>
        <a href="/pages/lookbook" class="nav-item-link">Lookbook</a>
      </li>

      <!-- 4. ABOUT US -->
      <li>
        <a href="/pages/about-us" class="nav-item-link">About Us</a>
      </li>

      <!-- 5. HELP -->
      <li class="nav-dropdown-parent">
        <a href="/pages/help" class="nav-item-link">Help</a>
        {%- assign support_email = settings.contact_email | default: shop.email -%}
        {%- if settings.contact_phone != blank or support_email != blank -%}
          <div class="nav-dropdown-menu nav-help-dropdown">
            <div class="dropdown-header-tag">Get Help</div>
            <div class="dropdown-contacts-list">
              {%- if settings.contact_phone != blank -%}
                <a href="tel:{{ settings.contact_phone_tel | default: settings.contact_phone }}" class="dropdown-contact-card" title="Call Us">
                  <div class="contact-card-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                  </div>
                  <div class="contact-card-details">
                    <span class="contact-card-label">Contact Us:</span>
                    <span class="contact-card-val">{{ settings.contact_phone }}</span>
                  </div>
                </a>
              {%- endif -%}

              {%- if settings.contact_whatsapp != blank -%}
                <a href="{{ settings.contact_whatsapp_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="dropdown-contact-card" title="WhatsApp Chat">
                  <div class="contact-card-icon contact-icon-whatsapp">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                    </svg>
                  </div>
                  <div class="contact-card-details">
                    <span class="contact-card-label">WhatsApp Us:</span>
                    <span class="contact-card-val">{{ settings.contact_whatsapp }}</span>
                  </div>
                </a>
              {%- endif -%}

              {%- if support_email != blank -%}
                <a href="mailto:{{ support_email }}" class="dropdown-contact-card" title="Email Us">
                  <div class="contact-card-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                  </div>
                  <div class="contact-card-details">
                    <span class="contact-card-label">Email Us:</span>
                    <span class="contact-card-val">{{ support_email }}</span>
                  </div>
                </a>
              {%- endif -%}
            </div>

            <div class="dropdown-divider" style="height:1px; background:var(--border-subtle); margin:0.6rem 0 0.4rem;"></div>
            <a href="/pages/help" class="dropdown-full-link" style="display:flex; align-items:center; justify-content:space-between; font-size:0.8rem; font-weight:600; color:var(--accent-terracotta-dark); text-decoration:none; padding:0.3rem 0.2rem;">
              <span>Full Help Center & FAQs</span>
              <span>&rarr;</span>
            </a>
          </div>
        {%- endif -%}
      </li>
    </ul>
  </nav>

  <!-- 3. Right: Search, Customer Account, Wishlist, Shopping Bag -->
  <div class="nav-actions">
    <!-- Search Trigger -->
    <button type="button" class="nav-action-btn" id="openSearchBtn" aria-label="Search Store" title="Search">
      {% render 'icon-search' %}
    </button>

    <!-- Customer Account Trigger -->
    <div class="nav-action-dropdown-parent">
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nav-action-btn {% if customer %}user-authenticated{% endif %}" id="openAccountBtn" aria-label="Account" title="{% if customer %}Account: {{ customer.first_name }}{% else %}Sign In{% endif %}">
        {%- if customer -%}
          <span class="user-avatar-circle" style="width:26px; height:26px; border-radius:50%; background:var(--accent-terracotta-dark); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:700;">
            {{ customer.first_name | slice: 0 | upcase }}
          </span>
        {%- else -%}
          {% render 'icon-account' %}
        {%- endif -%}
      </a>
    </div>

    <!-- Wishlist Trigger -->
    <a href="/pages/wishlist" class="nav-action-btn nav-wishlist-btn" id="openWishlistBtn" aria-label="Wishlist" title="Wishlist">
      {% render 'icon-wishlist' %}
      <span class="nav-badge" id="wishlistCountBadge">0</span>
    </a>

    <!-- Bag / Cart Trigger Pill -->
    <button type="button" class="nav-cart-pill" id="openCartBtn" aria-label="Shopping Bag">
      <span>Bag</span>
      <span class="nav-cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
    </button>

    <!-- Mobile Hamburger Trigger -->
    <button class="nav-mobile-toggle" id="mobileMenuToggle" aria-label="Toggle Navigation Menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Slide-out Drawer Navigation -->
  <div class="mobile-drawer" id="mobileDrawer">
    <div class="mobile-drawer-inner">
      <div class="mobile-drawer-header">
        <span class="mobile-drawer-brand">{{ section.settings.brand_text | default: settings.brand_name | default: 'Shugroves' }}</span>
        <button class="mobile-drawer-close" id="mobileDrawerClose" aria-label="Close Menu">&times;</button>
      </div>

      <nav class="mobile-nav-list">
        <!-- Collections -->
        <div class="mobile-nav-section">
          <span class="mobile-section-label">Collections</span>
          <a href="{{ routes.collections_url }}" class="mobile-nav-link">All Collections</a>
          {%- for col in collections limit: 5 -%}
            <a href="{{ col.url }}" class="mobile-nav-link">{{ col.title }}</a>
          {%- endfor -%}
        </div>

        <!-- Curations -->
        <div class="mobile-nav-section">
          <span class="mobile-section-label">Curations</span>
          <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="mobile-nav-link">Popular Pieces</a>
          <a href="/pages/offers" class="mobile-nav-link">Seasonal Offers</a>
          <a href="/pages/lookbook" class="mobile-nav-link">Seasonal Lookbook</a>
        </div>

        <!-- Atelier & Care -->
        <div class="mobile-nav-section">
          <span class="mobile-section-label">Atelier & Care</span>
          <a href="/pages/about-us" class="mobile-nav-link">About Us & Atelier Story</a>
          <a href="/pages/help" class="mobile-nav-link">Help & Customer Support</a>
          {%- if settings.contact_phone != blank -%}
            <a href="tel:{{ settings.contact_phone_tel | default: settings.contact_phone }}" class="mobile-nav-link">Call: {{ settings.contact_phone }}</a>
          {%- endif -%}
          {%- if settings.contact_whatsapp != blank -%}
            <a href="{{ settings.contact_whatsapp_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="mobile-nav-link">WhatsApp: {{ settings.contact_whatsapp }}</a>
          {%- endif -%}
        </div>

        <!-- Client Portal -->
        <div class="mobile-nav-section">
          <span class="mobile-section-label">Client Account</span>
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mobile-nav-link">{% if customer %}My Account ({{ customer.first_name }}){% else %}Sign In / Register{% endif %}</a>
          <a href="/pages/wishlist" class="mobile-nav-link">Saved Wishlist</a>
        </div>
      </nav>

      <div class="mobile-drawer-footer">
        <p>Handcrafted Slow Fashion &bull; Est. 2026</p>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Logo Text",
      "default": "Shugroves Emporium"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Megamenu Featured Collection"
    }
  ]
}
{% endschema %}
