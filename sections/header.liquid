{% comment %}
  Shugroves Emporium - Master Header Section
{% endcomment %}

<header class="site-header" id="siteHeader">
  <!-- 1. Left: Brand Logotype with Swash -->
  <a href="{{ routes.root_url }}" class="brand-container" id="brandElement" title="{{ shop.name }} Home">
    <span class="brand-title">{{ section.settings.brand_text | default: settings.brand_name | default: 'Shugroves Emporium' }}</span>
    <div class="brand-swash-box" aria-hidden="true">
      <svg viewBox="0 0 300 12" preserveAspectRatio="none">
        <path d="M 4,6 Q 150,-2 296,6" />
      </svg>
    </div>
  </a>

  <!-- 2. Center: Desktop Editorial Navigation Links -->
  <nav class="main-nav" aria-label="Main Navigation">
    <ul class="nav-links">
      <!-- 1. COLLECTIONS Dropdown -->
      <li class="nav-dropdown-parent">
        <a href="{{ routes.collections_url }}" class="nav-item-link">Collections</a>
        <div class="nav-megamenu" id="collectionsMegamenu">
          <div class="megamenu-search-wrap">
            {% render 'icon-search' %}
            <input 
              type="text" 
              class="megamenu-search-input" 
              id="collectionsSearchInput" 
              placeholder="Search Collections..." 
              autocomplete="off"
            >
          </div>

          <div class="megamenu-grid">
            <!-- Column 1: Categories List -->
            <div class="megamenu-col" id="colListCol1">
              <span class="megamenu-heading">Apparel & Tailoring</span>
              <div class="megamenu-links-dynamic" id="dynColList1">
                {%- if collections.size > 0 -%}
                  {%- for col in collections limit: 6 -%}
                    <a href="{{ col.url }}" class="megamenu-link-item">
                      <span>{{ col.title }}</span>
                      <span class="megamenu-link-arrow">&rarr;</span>
                    </a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ routes.collections_url }}" class="megamenu-link-item">
                    <span>All Collections</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>

            <!-- Column 2: Objects & Archive -->
            <div class="megamenu-col" id="colListCol2">
              <span class="megamenu-heading">Objects & Archive</span>
              <div class="megamenu-links-dynamic" id="dynColList2">
                {%- if collections.size > 6 -%}
                  {%- for col in collections offset: 6 limit: 6 -%}
                    <a href="{{ col.url }}" class="megamenu-link-item">
                      <span>{{ col.title }}</span>
                      <span class="megamenu-link-arrow">&rarr;</span>
                    </a>
                  {%- endfor -%}
                {%- else -%}
                  <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="megamenu-link-item">
                    <span>New Arrivals</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                  <a href="/pages/offers" class="megamenu-link-item">
                    <span>Seasonal Offers</span>
                    <span class="megamenu-link-arrow">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
              <a href="{{ routes.collections_url }}" class="megamenu-view-all">View All Collections &rarr;</a>
            </div>

            <!-- Column 3: Featured Editorial Card -->
            <div class="megamenu-col megamenu-featured-card-col">
              {%- assign featured_col = collections[section.settings.featured_collection] | default: collections.first -%}
              {%- if featured_col != blank -%}
                <a href="{{ featured_col.url }}" class="megamenu-card-preview">
                  <div class="megamenu-card-img-wrap">
                    {%- if featured_col.image != blank -%}
                      <img src="{{ featured_col.image | image_url: width: 600 }}" alt="{{ featured_col.title | escape }}">
                    {%- elsif featured_col.products.first.featured_image != blank -%}
                      <img src="{{ featured_col.products.first.featured_image | image_url: width: 600 }}" alt="{{ featured_col.title | escape }}">
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <div class="megamenu-card-overlay">
                      <span class="megamenu-card-badge">Featured Curation</span>
                      <h4 class="megamenu-card-title">{{ featured_col.title }}</h4>
                      <span class="megamenu-card-link">Explore Collection &rarr;</span>
                    </div>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </li>

      <!-- 2. POPULAR -->
      <li>
        <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="nav-item-link">Popular</a>
      </li>

      <!-- 3. LOOKBOOK -->
      <li>
        <a href="/pages/lookbook" class="nav-item-link">Lookbook</a>
      </li>

      <!-- 4. ABOUT US -->
      <li>
        <a href="/pages/about-us" class="nav-item-link">About Us</a>
      </li>

      <!-- 5. HELP -->
      <li class="nav-dropdown-parent">
        <a href="/pages/help" class="nav-item-link">Help</a>
        {%- if settings.contact_phone != blank or settings.contact_email != blank -%}
          <div class="nav-dropdown-menu nav-help-dropdown">
            <div class="dropdown-header-tag" style="font-size:0.7rem; letter-spacing:0.18em; text-transform:uppercase; color:var(--accent-sage-dark); font-weight:700; margin-bottom:0.6rem;">Atelier Concierge</div>
            <div class="dropdown-contacts-list">
              {%- if settings.contact_phone != blank -%}
                <a href="tel:{{ settings.contact_phone }}" class="dropdown-contact-card" title="Call Atelier">
                  <div class="contact-card-details">
                    <span class="contact-card-label">Client Services</span>
                    <span class="contact-card-val">{{ settings.contact_phone }}</span>
                  </div>
                </a>
              {%- endif -%}
              {%- if settings.contact_email != blank -%}
                <a href="mailto:{{ settings.contact_email }}" class="dropdown-contact-card" title="Email Atelier">
                  <div class="contact-card-details">
                    <span class="contact-card-label">Email Concierge</span>
                    <span class="contact-card-val">{{ settings.contact_email }}</span>
                  </div>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </li>
    </ul>
  </nav>

  <!-- 3. Right: Search, Customer Account, Wishlist, Shopping Bag -->
  <div class="nav-actions">
    <!-- Search Trigger -->
    <button type="button" class="nav-action-btn" id="openSearchBtn" aria-label="Search Store" title="Search">
      {% render 'icon-search' %}
    </button>

    <!-- Customer Account Trigger -->
    <div class="nav-action-dropdown-parent">
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nav-action-btn {% if customer %}user-authenticated{% endif %}" id="openAccountBtn" aria-label="Account" title="{% if customer %}Account: {{ customer.first_name }}{% else %}Sign In{% endif %}">
        {%- if customer -%}
          <span class="user-avatar-circle" style="width:26px; height:26px; border-radius:50%; background:var(--accent-terracotta-dark); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:700;">
            {{ customer.first_name | slice: 0 | upcase }}
          </span>
        {%- else -%}
          {% render 'icon-account' %}
        {%- endif -%}
      </a>
    </div>

    <!-- Wishlist Trigger -->
    <a href="/pages/wishlist" class="nav-action-btn nav-wishlist-btn" id="openWishlistBtn" aria-label="Wishlist" title="Wishlist">
      {% render 'icon-wishlist' %}
      <span class="nav-badge" id="wishlistCountBadge">0</span>
    </a>

    <!-- Bag / Cart Trigger Pill -->
    <button type="button" class="nav-cart-pill" id="openCartBtn" aria-label="Shopping Bag">
      <span>Bag</span>
      <span class="nav-cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Logo Text",
      "default": "Shugroves Emporium"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Megamenu Featured Collection"
    }
  ]
}
{% endschema %}
