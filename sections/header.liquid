{% comment %}
  Shugroves Emporium - Master Header Section
{% endcomment %}

<header class="site-header" id="siteHeader">
  <div class="header-container">
    
    <!-- 1. Left: Brand Logotype with Swash -->
    <a href="{{ routes.root_url }}" class="brand-container" id="brandElement" title="{{ shop.name }} Home">
      <span class="brand-logotype">{{ section.settings.brand_text | default: settings.brand_name | default: shop.name }}</span>
      <span class="brand-swash-box" aria-hidden="true">
        <svg viewBox="0 0 160 20" preserveAspectRatio="none" fill="none">
          <path d="M4 14C35 5 85 4 156 12C115 16 60 17 22 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </span>
    </a>

    <!-- 2. Center: Desktop Editorial Navigation Links -->
    <nav class="nav-links" aria-label="Main Navigation">
      <ul class="nav-menu-list">
        {%- assign main_menu = linklists[section.settings.menu] -%}
        {%- if main_menu != blank and main_menu.links.size > 0 -%}
          {%- for link in main_menu.links -%}
            {%- assign link_title_down = link.title | downcase -%}
            {%- if link_title_down contains 'collection' or link_title_down contains 'shop' -%}
              <!-- Collections Megamenu Dropdown -->
              <li class="nav-dropdown-parent">
                <a href="{{ link.url }}" class="nav-item-link">{{ link.title }}</a>
                <div class="nav-megamenu-panel" id="collectionsMegamenu">
                  <div class="megamenu-search-box">
                    {% render 'icon-search' %}
                    <input 
                      type="text" 
                      class="megamenu-search-input" 
                      id="collectionsSearchInput" 
                      placeholder="Filter Collections..." 
                      autocomplete="off"
                    >
                  </div>

                  <div class="megamenu-grid">
                    <!-- Column 1: Collections List -->
                    <div class="megamenu-col" id="colListCol1">
                      <span class="megamenu-heading">Shop by Category</span>
                      <div class="megamenu-links-dynamic" id="dynColList1">
                        {%- for collection in collections limit: 6 -%}
                          <a href="{{ collection.url }}" class="megamenu-link-item">
                            <span>{{ collection.title }}</span>
                            <span class="megamenu-link-arrow">&rarr;</span>
                          </a>
                        {%- endfor -%}
                      </div>
                    </div>

                    <!-- Column 2: Objects & Archive -->
                    <div class="megamenu-col" id="colListCol2">
                      <span class="megamenu-heading">Atelier & Archive</span>
                      <div class="megamenu-links-dynamic" id="dynColList2">
                        {%- for collection in collections offset: 6 limit: 6 -%}
                          <a href="{{ collection.url }}" class="megamenu-link-item">
                            <span>{{ collection.title }}</span>
                            <span class="megamenu-link-arrow">&rarr;</span>
                          </a>
                        {%- endfor -%}
                      </div>
                      <a href="{{ routes.collections_url }}" class="megamenu-view-all">View All Collections &rarr;</a>
                    </div>

                    <!-- Column 3: Featured Editorial Card -->
                    <div class="megamenu-col megamenu-featured-card-col">
                      {%- assign featured_col = collections[section.settings.featured_collection] | default: collections.first -%}
                      <a href="{{ featured_col.url | default: routes.all_products_collection_url }}" class="megamenu-card-preview">
                        <div class="megamenu-card-img-wrap">
                          {%- if featured_col.image != blank -%}
                            <img src="{{ featured_col.image | image_url: width: 600 }}" alt="{{ featured_col.title | escape }}">
                          {%- else -%}
                            <img src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?auto=format&fit=crop&w=600&q=85" alt="Seasonal Lookbook">
                          {%- endif -%}
                          <div class="megamenu-card-overlay">
                            <span class="megamenu-card-badge">Seasonal Curation</span>
                            <h4 class="megamenu-card-title">{{ featured_col.title | default: "Autumn / Winter '26" }}</h4>
                            <span class="megamenu-card-link">Explore Collection &rarr;</span>
                          </div>
                        </div>
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            {%- elsif link_title_down contains 'help' or link_title_down contains 'contact' -%}
              <!-- Help & Concierge Dropdown -->
              <li class="nav-dropdown-parent">
                <a href="{{ link.url }}" class="nav-item-link">{{ link.title }}</a>
                <div class="nav-dropdown-menu nav-help-dropdown">
                  <div class="dropdown-header-tag">Atelier Client Concierge</div>
                  <div class="dropdown-contacts-list">
                    {%- if settings.contact_phone != blank -%}
                      <a href="tel:{{ settings.contact_phone_tel | default: settings.contact_phone }}" class="dropdown-contact-card" title="Call Atelier">
                        <div class="contact-card-icon">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        </div>
                        <div class="contact-card-text">
                          <span class="contact-card-lbl">Telephone Inquiries</span>
                          <span class="contact-card-val">{{ settings.contact_phone }}</span>
                        </div>
                      </a>
                    {%- endif -%}

                    {%- if settings.contact_whatsapp != blank -%}
                      <a href="{{ settings.contact_whatsapp_url | default: '#' }}" target="_blank" rel="noopener noreferrer" class="dropdown-contact-card" title="Chat on WhatsApp">
                        <div class="contact-card-icon contact-icon-whatsapp">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        </div>
                        <div class="contact-card-text">
                          <span class="contact-card-lbl">WhatsApp Concierge</span>
                          <span class="contact-card-val">{{ settings.contact_whatsapp }}</span>
                        </div>
                      </a>
                    {%- endif -%}

                    {%- if settings.contact_email != blank -%}
                      <a href="mailto:{{ settings.contact_email }}" class="dropdown-contact-card" title="Email Concierge">
                        <div class="contact-card-icon">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        </div>
                        <div class="contact-card-text">
                          <span class="contact-card-lbl">Email Atelier</span>
                          <span class="contact-card-val">{{ settings.contact_email }}</span>
                        </div>
                      </a>
                    {%- endif -%}
                  </div>
                  <div class="dropdown-divider"></div>
                  <a href="{{ link.url }}" class="dropdown-link-item dropdown-contact-item">
                    <span>Open Full Help Center &rarr;</span>
                  </a>
                </div>
              </li>
            {%- else -%}
              <li><a href="{{ link.url }}" class="nav-item-link">{{ link.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Navigation -->
          <li class="nav-dropdown-parent">
            <a href="{{ routes.collections_url }}" class="nav-item-link">Collections</a>
            <div class="nav-megamenu-panel">
              <div class="megamenu-grid">
                <div class="megamenu-col">
                  <span class="megamenu-heading">Apparel</span>
                  <div class="megamenu-links-dynamic">
                    {%- for col in collections limit: 5 -%}
                      <a href="{{ col.url }}" class="megamenu-link-item">{{ col.title }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          </li>
          <li><a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="nav-item-link">Popular</a></li>
          <li><a href="/pages/lookbook" class="nav-item-link">Lookbook</a></li>
          <li><a href="/pages/about-us" class="nav-item-link">About Us</a></li>
          <li><a href="/pages/help" class="nav-item-link">Help</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- 3. Right: Search, Customer Account, Wishlist, Shopping Bag -->
    <div class="nav-actions">
      <!-- Search Trigger -->
      <button type="button" class="nav-action-btn" id="openSearchBtn" aria-label="Search Store" title="Search">
        {% render 'icon-search' %}
      </button>

      <!-- Customer Account Dropdown Trigger -->
      <div class="nav-action-dropdown-parent">
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nav-action-btn {% if customer %}user-authenticated{% endif %}" id="openAccountBtn" aria-label="Account" title="{% if customer %}Account: {{ customer.first_name }}{% else %}Sign In{% endif %}">
          {%- if customer -%}
            <span class="user-avatar-circle" style="width:26px; height:26px; border-radius:50%; background:var(--accent-terracotta-dark); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:0.72rem; font-weight:700;">
              {{ customer.first_name | slice: 0 | upcase }}
            </span>
          {%- else -%}
            {% render 'icon-account' %}
          {%- endif -%}
        </a>

        <!-- Account Dropdown Menu -->
        <div class="nav-dropdown-menu nav-account-dropdown">
          {%- if customer -%}
            <div class="dropdown-user-header">
              <span class="user-greeting">Client Ledger</span>
              <strong class="user-name-display">{{ customer.name }}</strong>
              <small class="user-email-display">{{ customer.email }}</small>
            </div>
            <div class="dropdown-divider"></div>
            <a href="{{ routes.account_url }}" class="dropdown-link-item">
              <span>Orders & Live Tracking</span>
            </a>
            <a href="{{ routes.account_addresses_url }}" class="dropdown-link-item">
              <span>Saved Delivery Addresses</span>
            </a>
            <a href="/pages/wishlist" class="dropdown-link-item">
              <span>Saved Wishlist</span>
              <span class="dropdown-badge-mini" id="dropdownWishlistCount">0</span>
            </a>
            <div class="dropdown-divider"></div>
            <a href="{{ routes.account_logout_url }}" class="dropdown-signout-btn" style="display:block;text-align:center;">
              <span>Sign Out</span>
            </a>
          {%- else -%}
            <div class="dropdown-user-header">
              <span class="user-greeting">Client Portal</span>
              <strong class="user-name-display">Private Atelier Access</strong>
            </div>
            <div class="dropdown-divider"></div>
            <a href="{{ routes.account_login_url }}" class="btn-primary dropdown-auth-btn" style="display:block;text-align:center;">
              <span>Sign In &rarr;</span>
            </a>
            <a href="{{ routes.account_register_url }}" class="dropdown-link-item" style="text-align:center;margin-top:0.5rem;">
              <span>Create an Account</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Wishlist Trigger -->
      <a href="/pages/wishlist" class="nav-action-btn nav-wishlist-btn" id="openWishlistBtn" aria-label="Wishlist" title="Saved Wishlist">
        {% render 'icon-wishlist' %}
        <span class="nav-badge" id="wishlistCountBadge">0</span>
      </a>

      <!-- Shopping Bag Trigger -->
      <button type="button" class="nav-cart-pill" id="openCartBtn" aria-label="Shopping Bag">
        <span>Bag</span>
        <span class="nav-cart-count" id="cartCountBadge">{{ cart.item_count }}</span>
      </button>

      <!-- Mobile Hamburger Trigger -->
      <button type="button" class="nav-mobile-toggle" id="mobileMenuToggle" aria-label="Toggle Navigation Menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

    <!-- Mobile Slide-out Drawer Navigation -->
    <div class="mobile-drawer" id="mobileDrawer">
      <div class="mobile-drawer-inner">
        <div class="mobile-drawer-header">
          <span class="mobile-drawer-brand">{{ settings.brand_name | default: shop.name }}</span>
          <button type="button" class="mobile-drawer-close" id="mobileDrawerClose" aria-label="Close Menu">&times;</button>
        </div>

        <nav class="mobile-nav-list">
          <div class="mobile-nav-section">
            <span class="mobile-section-label">Collections</span>
            <a href="{{ routes.collections_url }}" class="mobile-nav-link">All Collections</a>
            {%- for col in collections limit: 6 -%}
              <a href="{{ col.url }}" class="mobile-nav-link">{{ col.title }}</a>
            {%- endfor -%}
          </div>

          <div class="mobile-nav-section">
            <span class="mobile-section-label">Curations</span>
            <a href="{{ routes.all_products_collection_url }}?sort_by=best-selling" class="mobile-nav-link">Popular Pieces</a>
            <a href="/pages/offers" class="mobile-nav-link">Seasonal Offers</a>
            <a href="/pages/about-us" class="mobile-nav-link">About Us & Atelier Story</a>
            <a href="/pages/help" class="mobile-nav-link">Help & Customer Support</a>
          </div>

          <div class="mobile-nav-section">
            <span class="mobile-section-label">Client Portal</span>
            {%- if customer -%}
              <a href="{{ routes.account_url }}" class="mobile-nav-link">My Orders & Tracking</a>
              <a href="{{ routes.account_addresses_url }}" class="mobile-nav-link">Saved Addresses</a>
              <a href="{{ routes.account_logout_url }}" class="mobile-nav-link" style="color:var(--accent-terracotta-dark);">Sign Out</a>
            {%- else -%}
              <a href="{{ routes.account_login_url }}" class="mobile-nav-link">Client Sign In</a>
              <a href="{{ routes.account_register_url }}" class="mobile-nav-link">Create Account</a>
            {%- endif -%}
            <a href="/pages/wishlist" class="mobile-nav-link">Saved Wishlist</a>
          </div>
        </nav>

        <div class="mobile-drawer-footer">
          <p>Handcrafted Slow Fashion • {{ 'now' | date: '%Y' }}</p>
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Logo Text",
      "default": "Shugroves Emporium"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Megamenu Featured Collection"
    }
  ]
}
{% endschema %}
