<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title | default: 'Shugroves Emporium | Artisanal Fashion, Raw Linen & Slow Luxury' }}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="Shugroves Emporium - Artisanal everyday luxury garments crafted with raw Belgian linens, vegetal dyes, and organic silhouettes that flow with you.">
  {%- endif -%}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Tenor+Sans&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <!-- Master Stylesheet -->
  {{ 'style.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <!-- Subtle Tactile Texture Overlay -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- Master Header Section -->
  {% section 'header' %}

  <!-- Main Content Container -->
  <main id="appMain" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Master Footer Section -->
  {% section 'footer' %}

  <!-- Global Slide-Over Shopping Bag Drawer -->
  {% render 'cart-drawer' %}

  <!-- Global Fullscreen Live Search Overlay -->
  {% render 'search-modal' %}

  <!-- Global Toast Notifications Container -->
  {% render 'toast' %}

  <!-- Interactive Replay Intro Transition Control (Home only) -->
  <button class="replay-control" id="replayBtn" aria-label="Replay Entrance Sequence">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="1 4 1 10 7 10"></polyline>
      <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
    </svg>
    <span>Replay Entrance</span>
  </button>

  <!-- Theme JavaScript Engine -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
