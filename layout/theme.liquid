<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F6F4EE">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <!-- Stylesheet -->
  {{ 'style.css' | asset_url | stylesheet_tag }}
</head>

<body class="template-{{ template.name }}">
  <a class="skip-to-content-link visually-hidden" href="#appMain" style="position:absolute;left:-9999px;">
    Skip to content
  </a>

  <!-- Persistent Dynamic Header -->
  <header class="site-header" id="siteHeader"></header>

  <!-- Interactive Search Overlay -->
  <div class="search-overlay" id="searchOverlay"></div>

  <!-- Interactive Sliding Shopping Bag Drawer -->
  <div class="cart-drawer" id="cartDrawer"></div>

  <!-- Interactive Firebase Authentication Modal -->
  <div class="auth-modal" id="authModal"></div>

  <!-- Main Dynamic View Container -->
  <main id="appMain" role="main">
    {{ content_for_layout }}
  </main>

  <!-- Persistent Dynamic Footer -->
  <footer class="site-footer" id="siteFooter"></footer>

  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- Theme Client Modules & Storefront Engine -->
  <script type="module" src="{{ 'script.js' | asset_url }}"></script>
</body>
</html>
